# Cloudflare Pages applies these headers to served assets. Pages merges every
# rule whose path matches, so a header set in /* must be detached (`! Name`)
# before a more specific rule overrides it; otherwise both values are sent.

# Default for HTML and everything else: short edge cache so a fresh build is
# picked up promptly, long stale-while-revalidate so users get an instant page.
/*
  Cache-Control: public, max-age=0, s-maxage=3600, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed Next.js assets are immutable.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Other static assets (favicons etc.): cache hard, refresh weekly.
/*.ico
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
